<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark Space Theme -->
    <style name="Theme.SFSAI" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/primary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/background</item>
        <item name="colorWarning">@color/warning</item>
    </style>

    <style name="Theme.SFSAI.Splash" parent="Theme.SFSAI">
        <item name="android:windowBackground">@color/background</item>
    </style>
</resources>
